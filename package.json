{
  "name": "remontvision",
  "version": "1.0.0",
  "description": "Ремонт по фото: AI-рендер + список реальных материалов с ценами",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "dev": "node --watch --env-file=.env src/server.js",
    "test": "node --test test/*.test.js",
    "test:integration": "node --env-file-if-exists=.env --test --test-concurrency=1 test/integration/*.test.js",
    "check:copy": "node scripts/check-copy.mjs",
    "catalog:images": "node --env-file=.env scripts/generate-catalog-images.mjs",
    "docs:llms": "node scripts/build-llms-full.mjs",
    "kit:build": "node scripts/build-kit.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@openrouter/agent": "^1.0.0",
    "@openrouter/sdk": "^1.5.56",
    "express": "^4.21.2",
    "fast-xml-parser": "^5.11.2",
    "multer": "^1.4.5-lts.2",
    "node-fetch": "^3.3.2",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "sharp": "^0.33.5",
    "socks-proxy-agent": "^10.1.0",
    "undici": "^6.29.1",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true
  }
}
