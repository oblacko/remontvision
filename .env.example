# Ключ OpenRouter: https://openrouter.ai/keys
# Без ключа приложение работает в демо-режиме (мок-рендер, без расходов).
OPENROUTER_API_KEY=

# Модель рендера. Проверить доступные: GET https://openrouter.ai/api/v1/images/models
# (или запустить приложение и открыть /api/models — вернёт список с поддержкой референсов)
# При старте приложение сверяет slug со списком OpenRouter и падает с ошибкой, если модели нет.
# Осторожно: slug'и меняются, значения ниже — актуальные на октябрь 2026, проверьте перед запуском.
RENDER_MODEL=google/gemini-3.1-flash-image-preview
VISION_MODEL=google/gemini-3-flash-preview
# Фолбэк: один ретрай рендера на этой модели, если основная упала. Пусто = без ретрая.
RENDER_MODEL_FALLBACK=google/gemini-nano-banana-2.1

PORT=3000
# APP_URL=https://your-domain.ru

# Таймаут вызовов OpenRouter, мс (по умолчанию 120000)
# OPENROUTER_TIMEOUT_MS=120000

# Rate limit на POST /api/rooms и /iterate (N задач за окно на IP). 0 — выключить.
# RATE_LIMIT_MAX=5
# RATE_LIMIT_WINDOW_MS=3600000
# OTP_BYPASS_EMAILS=support@remontvision.ru
# OTP_RESEND_SECONDS=60
# OTP_DAILY_LIMIT=10
# SESSION_DAYS=30
# OTP_BYPASS_EMAILS=support@remontvision.ru

# Postgres. ВНИМАНИЕ: переменная называется RV_DATABASE_URL, а не DATABASE_URL —
# стандартное имя может быть глобально экспортировано в окружении (на машине разработки
# ~/.bashrc экспортирует DATABASE_URL другого проекта, а Node --env-file его не перебивает).
# Локально compose-db проброшен на 5434; внутри compose-сети app ходит на db:5432.
RV_DATABASE_URL=postgres://remont:remont@127.0.0.1:5434/remontvision
DB_PASSWORD=remont
# Отправка кодов: Resend (приоритет), иначе SMTP, иначе json-лог (dev-режим).
# RESEND_API_KEY=re_...
# RESEND_TEMPLATE_ID=tmpl_...  # если задан — письмо отправляется по шаблону Resend
# MAIL_FROM=ремонтвижн <noreply@remontvision.ru>
# MAIL_REPLY_TO=support@remontvision.ru
# SMTP_URL=smtps://user:pass@smtp.yandex.ru:465

# Админка каталога (/api/admin/products): заголовок X-Admin-Key
# ADMIN_KEY=

# Провайдер оплаты: robokassa | yukassa. Пусто — robokassa, если настроена, иначе yukassa.
# PAYMENT_PROVIDER=robokassa
# APP_URL обязателен для боевых ссылок оплаты (return/webhook):
# APP_URL=https://your-domain.ru

# Robokassa: MerchantLogin и технические пароли из личного кабинета.
# ResultURL:  ${APP_URL}/api/payments/robokassa/result
# SuccessURL: ${APP_URL}/cabinet/paid
# FailURL:    ${APP_URL}/cabinet/fail
# Для тестового режима используйте тестовые пароли и ROBOKASSA_TEST=1.
# ROBOKASSA_LOGIN=
# ROBOKASSA_PASSWORD_1=
# ROBOKASSA_PASSWORD_2=
# ROBOKASSA_PASSWORD_3=
# ROBOKASSA_TEST=1
# ROBOKASSA_HASH_ALGO=md5
# ROBOKASSA_PAYMENT_METHOD=BankCard
# ROBOKASSA_NO_FREE_SALE=1
# Receipt с номенклатурой для чеков (Робочеки СМЗ / облачная касса). По умолчанию включён.
# ROBOKASSA_RECEIPT_ENABLED=1

# ЮKassa (самозанятый подходит). Тестовые shopId/secret: https://yookassa.ru/my
# YUKASSA_SHOP_ID=
# YUKASSA_SECRET_KEY=

# Подбор товаров по рендеру: Yandex Search API + allowlist магазинов.
# YANDEX_SEARCH_API_KEY=
# YANDEX_FOLDER_ID=
# PROCUREMENT_ENABLED=1
# PROCUREMENT_REGION=213
# PROCUREMENT_DOMAINS=divan.ru,askona.ru,stoolgroup.ru,divanboss.ru,sonum.ru,wooden-world.ru,mebelion.ru,mnogosna.ru,leoparquet.ru,poli24.ru,profiplitka.ru,sanok.ru
# PROCUREMENT_MIN_SCORE=80
# PROCUREMENT_ALT_SCORE=70
# PROCUREMENT_MAX_RUN_COST_USD=0.5

# Объектное хранилище S3 (reg.cloud, endpoint https://s3.regru.cloud).
# Когда заданы BUCKET+ключи — файлы (загрузки, рендеры, фото товаров) идут в S3,
# наши /files//renders//products/ отдают 302 на presigned URL. Не заданы — локальный диск data/.
# S3_ENDPOINT=https://s3.regru.cloud
# S3_REGION=us-east-1
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_URL_TTL=86400

# Включение денег: платежи — отдельно, возвраты — только после state machine.
# PAYMENTS_ENABLED=true
# REFUNDS_ENABLED=false

# Чеки самозанятого: вебхук интеграции с «Мой налог» / ЮKassa или своим сценарием.
# Без URL чек сохраняется в таблице receipts со статусом pending (видно в логах).
# RECEIPTS_WEBHOOK_URL=
# RECEIPTS_API_KEY=
