    "\n{\n  \"@context\": \"https://schema.org\",\n  \"@graph\": [\n    {\n      \"@type\": \"WebSite\",\n      \"@id\": \"https://www.remontvision.ru/#website\",\n      \"url\": \"https://www.remontvision.ru/\",\n      \"name\": \"Ремонтвижн\",\n      \"inLanguage\": \"ru-RU\",\n      \"description\": \"AI-сервис визуализации ремонта по фото"
