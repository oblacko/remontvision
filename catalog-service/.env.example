# Каталог-сервис: своя БД Postgres + pgvector.
CATALOG_DATABASE_URL=postgresql://catalog:catalog@catalog-db:5432/catalog
CATALOG_SERVICE_TOKEN=change-me

# fake — без torch (тесты); histogram — цвет/композиция без torch (не семантика);
# torch — семантические эмбеддинги DINOv2 через timm (нужен INSTALL_ML=1).
EMBEDDER=torch
EMBED_MODEL=vit_base_patch14_dinov2.lvd142m
EMBED_DIM=768
EMBED_CONCURRENCY=8
# Цветовой re-rank поверх DINOv2: вес цвета (0..0.9) и размер пула кандидатов.
COLOR_RERANK_WEIGHT=0.3
COLOR_RERANK_POOL=100
MAX_FEED_BYTES=300000000
HTTP_TIMEOUT_S=30
